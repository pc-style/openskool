# The service worker, its asset list, the manifest and the HTML must revalidate so updates reach people.
/sw.js
  Cache-Control: no-cache
/sw-assets.json
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Hashed build output never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
